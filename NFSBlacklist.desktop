#!/usr/bin/env xdg-open
[Desktop Entry]
Name=NFSBlacklist
Comment=Install NFSBlacklist
Exec=bash -c 'f=$(mktemp --suffix=.sh) && curl -sfL https://raw.githubusercontent.com/GalvarinoDev/NFSBlacklist/main/launcher.sh -o "$f" && bash "$f"; rm -f "$f"'
Icon=applications-games
Terminal=true
Type=Application
Categories=Game;
StartupNotify=false
