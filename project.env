# project.env - the one place project identity lives.
# Read by every shell script (source) and by src/identity.py (parsed).
# tools/new_project.py fills this in; edit by hand after that.
# Plain KEY=value lines only (no spaces around =, quote values with spaces).

APP_ID=nfsblacklist
APP_TITLE=NFSBlacklist
APP_COMMENT="NFSBlacklist - Black Box NFS on SteamOS"
GITHUB_USER=GalvarinoDev
GITHUB_REPO=NFSBlacklist
GITHUB_BRANCH=main
INSTALL_DIR_NAME=NFSBlacklist
# Shown next to the title (e.g. NIGHTLY BUILD); empty for none
BUILD_BADGE=
# Never overwritten or deleted by updates (space separated, relative to the install dir)
PROTECTED="logs/ config.json assets/music/background.mp3"
# Optional background music, downloaded at install (empty to skip)
MUSIC_URL=https://dn710406.ca.archive.org/0/items/background_20260515/background.mp3
